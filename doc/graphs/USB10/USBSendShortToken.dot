digraph USBMain {

	labelloc="t";
	label="USB 1.0 Controller USBSendShortToken FSM";

	rankdir=TB; // Layout from top to bottom
	node [shape=Mrecord]; // Shape of the nodes
	//graph [splines = ortho];

	//layout=twopi
	//root=StateUnconnected


	Init [penwidth=3, label = "{Init|bit_count := 0\nio.ready := False\nbuffer := ~io.pid ## io.pid ## B\"10000000\"}"];
	Init -> Valid_box; Valid_box [shape = diamond, label = "valid ?"];
	//Valid_box -> Init [label = "False"];
	Valid_box -> ClockDiv; ClockDiv [penwidth=2, label = "{Clock Divider|clock_div++}"];
	ClockDiv -> Strobe_box; Strobe_box [shape = diamond, label = "clock_div === io.clock_div"];
	Strobe_box -> CountBits; CountBits [penwidth=2, label = "{Bit Counter|clock_div := 0\nbit_count++}"];
	//Strobe_box -> ClockDiv;

	CountBits -> LessThan16_box:n; LessThan16_box [shape = diamond, label = "bit_count < 16"];
	LessThan16_box -> SendBit; SendBit [shape = record, label = "{SendBit|bit_count++\nbit_to_send := buffer(bit_count)}"];

	SendBit -> SendBit_box:n; SendBit_box [shape = diamond, label = "toKJ(bit_to_send) === K"];
	SendBit_box -> SendSymbol_K:n; SendSymbol_K [shape = record, label ="{SendSymbolK|io.usb_dm := False\nio.usb_dp := True}"];
	SendBit_box -> SendSymbol_J:n; SendSymbol_J [shape = record, label ="{SendSymbolJ|io.usb_dm := True\nio.usb_dp := False}"];

	CountBits -> Is16:n; Is16 [shape = diamond, label = "bit_count === 16\nor\nbit_count === 17"]; Is16 -> Is16_box; Is16_box [shape = record, label = "{Send EOP: 'SE0'|io.usb_dm := False\nio.usb_dp := False}"];

	CountBits -> Is1819_box:n; Is1819_box [shape = diamond, label = "bit_count === 18\nor\nbit_count === 19"];
	Is1819_box -> Is1819:n; Is1819 [shape = record, label = "{Send EOP: 'J'|io.usb_dm := True\nio.usb_dp := False}"];

	CountBits -> Is20:n; Is20 [shape = diamond, label = "bit_count === 20"]; Is20 -> Is20_box; Is20_box [shape = record, label = "{Ready, Send EOP: 'J'|io.usb_dm := True\nio.usb_dp := False\nio.ready := True\nbit_count := 20}"];


	subgraph cluster_1 {
		
		label="toKJ()"
		labeljust=right
		rankdir=TB;
		color=blue;
		graph[margin="50"]

		toKJ [label = "{toKJ(bit_to_send)|}", rankjustify=min]; toKJ -> toKJ_check; toKJ_check [shape = diamond, label = "bit_to_send ?"];
		toKJ_check -> toKJ_remain [label = "1"]; toKJ_remain [shape = box, label = "return last_kj"];
		toKJ_check -> toKJ_transition [label = "0"]; toKJ_transition [shape = box, label = "last_kj := ~last_kj;\nreturn ~last_kj"];
		toKJ_remain -> toKJ; toKJ_transition -> toKJ;

	}
}

