digraph USBMain {

	labelloc="t";
	label="USB 1.0 Controller Main FSM";

	//rankdir=LR; // Layout from left to right
	rankdir=TB; // Layout from top to bottom
	node [shape=Mrecord]; // Shape of the nodes
	graph [splines = ortho];

	//layout=twopi
	//root=StateUnconnected

	StateUnconnected [penwidth=3, label = "{StateUnconnected|T0 := 0, T1 := 0}"];

	StateWaitCMDorSYNC [penwidth=2, label = "{StateWaitCMDorSYNC|T1++ // Guard timer\nT2++ // Keepalive timer}"];

	StateUnconnected -> StateWaitCMDorSYNC0; StateWaitCMDorSYNC0 [shape = box, label = "bus_present" ]; StateWaitCMDorSYNC0 -> StateWaitCMDorSYNC;

	StateWaitCMDorSYNC -> StateSendReset0; StateSendReset0 [ shape = box, label = "cmd_start &&\ncmd === CMDBusReset" ]; StateSendReset0 -> StateSendReset;
	StateSendReset [label = "{StateSendReset|send_bus_reset.io.valid := True\nsend_bus_reset.io.usb_dm \<\> io.usb.usb_dm\nsend_bus_reset.io.usb_dp \<\> io.usb.usb_dp}"];
	StateSendReset -> StateWaitCMDorSYNC2; StateWaitCMDorSYNC2 [shape = box, label = "send_bus_reset.io.ready"]; StateWaitCMDorSYNC2 -> StateWaitCMDorSYNC22; StateWaitCMDorSYNC22 [label = "StateWaitCMDorSYNC"];
	StateSendReset-> StateUnconnected3; StateUnconnected3 [shape = box, label = "bus_error"]; StateUnconnected3 -> StateUnconnected32; StateUnconnected32 [label = "StateUnconnected"];


	StateWaitCMDorSYNC -> StateSendShortToken0; StateSendShortToken0 [ shape = box, label = "cmd_start &&\ncmd === CMDSendShortToken" ]; StateSendShortToken0 -> StateSendShortToken; StateSendShortToken [ label = "{StateSendShortToken|send_short_token.io.valid := True\nsend_short_token.io.usb_dm \<\> io.usb.usb_dm\nsend_short_token.io.usb_dp \<\> io.usb.usb_dp\nsend_short_token.io.pid := cmd_pid}"];
	StateWaitCMDorSYNC -> StateSendLongToken0; StateSendLongToken0 [ shape = box, label = "cmd_start &&\ncmd === CMDSendLongToken" ]; StateSendLongToken0 -> StateSendLongToken; StateSendLongToken [ label = "{StateSendLongToken|send_long_token.io.valid := True\nsend_long_token.io.usb_dm \<\>\ io.usb.usb_dm\nsend_long_token.io.usb_dp \<\> io.usb.usb_dp\nsend_long_token.io.pid := cmd_pid\nsend_long_token.io.addr := cmd_addr\nsend_long_token.io.endp := cmd_endp}"];
	StateWaitCMDorSYNC -> StateSendData0; StateSendData0 [ shape = box, label = "cmd_start &&\ncmd === CMDSendData" ]; StateSendData0 -> StateSendData; StateSendData [ label = "{StateSendData|send_data.io.valid := True\nsend_data.io.usb_dm \<\> io.usb.usb_dm\nsend_data.io.usb_dp \<\> io.usb.usb_dp\nsend_data.io.pid := cmd_pid\nsend_data.io.len := cmd_len\nsend_data.io.data := send_data_high ##\n  send_data_low}"];
	StateWaitCMDorSYNC -> StateReceive0; StateReceive0 [ shape = box, label = "bus_activity" ]; StateReceive0 -> StateReceive; StateReceive [label = "{StateReceive|receiver.io.valid := True\nreceiver.io.usb_dm \<\> io.usb.usb_dm\nreceiver.io.usb_dp \<\> io.usb.usb_dp}"];

	StateWaitCMDorSYNC -> StateKeepAlive0; StateKeepAlive0 [shape = box, label = "keepalive_enable &&\nT2 === USBLowSpeedKeepAliveClocks"]; StateKeepAlive0 -> StateKeepAlive;
	StateKeepAlive -> StateWaitCMDorSYNC1; StateWaitCMDorSYNC1 [shape = box, label = "send_keepalive.io.ready"]; StateWaitCMDorSYNC1 -> StateWaitCMDorSYNC12; StateWaitCMDorSYNC12 [label = "StateWaitCMDorSYNC"];
	StateKeepAlive -> StateUnconnected1; StateUnconnected1 [shape = box, label = "bus_error"]; StateUnconnected1 -> StateUnconnected12; StateUnconnected12 [label = "StateUnconnected"];
	StateKeepAlive [ label = "{StateKeepAlive|send_keepalive.io.valid := True\nsend_keepalive.io.usb_dm \<\> io.usb.usb_dm\nsend_keepalive.io.usb_dp \<\> io.usb.usb_dp}" ]; 

	StateWaitCMDorSYNC -> StateUnconnected2 [dir=backward]; StateUnconnected2 -> StateUnconnected [dir=backward]; StateUnconnected2 [ shape = box, label = "bus_error"];

	StateReceive -> StateWaitCMDorSYNC3; StateWaitCMDorSYNC3 [shape = box, label = "receiver.io.ready"]; StateWaitCMDorSYNC3 -> StateWaitCMDorSYNC32; StateWaitCMDorSYNC32 [label = "StateWaitCMDorSYNC"];
	StateReceive -> StateUnconnected4; StateUnconnected4 [shape = box, label = "bus_error"]; StateUnconnected4 -> StateUnconnected42; StateUnconnected42 [label = "StateUnconnected"];

	StateSendData -> StateWaitCMDorSYNC4; StateWaitCMDorSYNC4 [shape = box, label = "send_data.io.ready"]; StateWaitCMDorSYNC4 -> StateWaitCMDorSYNC42; StateWaitCMDorSYNC42 [label = "StateWaitCMDorSYNC"];
	StateSendData -> StateUnconnected5; StateUnconnected5 [shape = box, label = "bus_error"]; StateUnconnected5 -> StateUnconnected52; StateUnconnected52 [label = "StateUnconnected"];

	StateSendShortToken -> StateWaitCMDorSYNC5; StateWaitCMDorSYNC5 [shape = box, label = "send_short_token.io.ready"]; StateWaitCMDorSYNC5 -> StateWaitCMDorSYNC52; StateWaitCMDorSYNC52 [label = "StateWaitCMDorSYNC"];
	StateSendShortToken -> StateUnconnected6; StateUnconnected6 [shape = box, label = "bus_error"]; StateUnconnected6 -> StateUnconnected62; StateUnconnected62 [label = "StateUnconnected"];

	StateSendLongToken -> StateWaitCMDorSYNC6; StateWaitCMDorSYNC6 [shape = box, label = "send_long_token.io.ready"]; StateWaitCMDorSYNC6 -> StateWaitCMDorSYNC62; StateWaitCMDorSYNC62 [label = "StateWaitCMDorSYNC"];
	StateSendLongToken -> StateUnconnected7; StateUnconnected7 [shape = box, label = "bus_error"]; StateUnconnected7 -> StateUnconnected72; StateUnconnected72 [label = "StateUnconnected"];
}

