digraph USBReceiver {

	subgraph cluster_3 {
	
		label = "Phase 3. Receive Data"
		rankdir=TB; // Layout from top to bottom
		node [shape=Mrecord]; // Shape of the nodes
	
		StateRecevingData[penwidth=2, label = "{Receive Data|T0 := 0; T1 := 0; bit_count := 0; ones := 0;\nlast_dp := False; last_symbol := True;}"];
		StateRecevingData -> StateRecevingData_Overflow_diamond; StateRecevingData_Overflow_diamond[shape = "diamond", label = "bit_count === 127"]
		StateRecevingData_Overflow_diamond -> StateReady31[label = "Overflow ?"]; StateReady31[label = "StateReady"]
		//StateReady31 -> StateRecevingData_SE0_diamond[style = "invis"]

	
		StateRecevingData -> StateRecevingData_ValidData_diamond; StateRecevingData_ValidData_diamond[shape = "diamond", label = "io.usb_dp =/= io.usb_dm"];
		StateRecevingData_ValidData_diamond -> StateRecevingData_ValidData_box[label = "Valid data ?"]; StateRecevingData_ValidData_box[shape = "box", label = "T0++;\nlast_dp := io.usb_dp;"];
		StateRecevingData_ValidData_box:w -> StateRecevingData_ValidData_Timeout_diamond; StateRecevingData_ValidData_Timeout_diamond[shape = "diamond", label = "T0 === 255"];
		StateRecevingData_ValidData_Timeout_diamond -> StateReady3[label = "Timeout ?"]; StateReady3[label = "StateReady"]
	

		StateRecevingData -> StateRecevingData_SE0_diamond; StateRecevingData_SE0_diamond[shape = "diamond", label = "!io.usb_dp\nand\n!io.usb_dm"]
		StateRecevingData_SE0_diamond -> StateRecevingData_SE0_Sample_box[label = "SE0 ?"]; StateRecevingData_SE0_Sample_box[shape = "box", label = "T1++;"];
		StateRecevingData_SE0_Sample_box -> StateRecevingData_SE0_Sample_diamond; StateRecevingData_SE0_Sample_diamond[shape = "diamond", label = "T1 === bit_duration"];
		StateRecevingData_SE0_Sample_diamond -> StateReady32[label = "EOP ?"]; StateReady32[penwidth=3, label = "{StateReady|io.ready := True}"];

	
		StateRecevingData_ValidData_box -> StateRecevingData_ValidData_ReSync_diamond; StateRecevingData_ValidData_ReSync_diamond[shape = "diamond", label = "last_dp =/= io.usb_dp"];
		//StateReady3 -> StateRecevingData_ValidData_ReSync_diamond[style = "invis"];
	
		StateRecevingData_ValidData_ReSync_diamond -> StateRecevingData_ValidData_ReSync_box[label = "Edge ?"]; StateRecevingData_ValidData_ReSync_box[shape = "box", label = "/* Re-Sync */\nT0 := 0;"]
		//StateRecevingData_ValidData_box -> StateRecevingData_ValidData_BitDuration_diamond; StateRecevingData_ValidData_BitDuration_diamond[shape = "diamond", label = "T0 === bit_duration"];
		//StateRecevingData_ValidData_BitDuration_diamond -> StateRecevingData_ValidData_ReSync_box[label = "Too long ?"];
	
		StateRecevingData_ValidData_box:e -> StateRecevingData_ValidData_HalfBitDuration_diamond; StateRecevingData_ValidData_HalfBitDuration_diamond[shape = "diamond", label = "T0 === bit_duration / 2"];
		StateRecevingData_ValidData_HalfBitDuration_diamond -> StateRecevingData_ValidData_HalfBitDuration_box[label = "Time to sample"];
		StateRecevingData_ValidData_HalfBitDuration_box[shape = "box", label = "/* Sample one bin */\nbit_received := (io.usb_dp === last_symbol)\nlast_symbol := io.usb_dp;"]
		
		StateRecevingData_ValidData_HalfBitDuration_box:w -> StateRecevingData_ValidData_IsOne_diamond; StateRecevingData_ValidData_IsOne_diamond[shape = "diamond", label = "bit_received === True"];
		StateRecevingData_ValidData_IsOne_diamond -> StateRecevingData_ValidData_One_box[label = "'1'"]; StateRecevingData_ValidData_One_box[shape = "box", label = "ones++;"]
		StateRecevingData_ValidData_IsOne_diamond -> StateRecevingData_ValidData_Zero_box[label = "'0'"]; StateRecevingData_ValidData_Zero_box[shape = "box", label = "ones := 0;"]
		//StateRecevingData_ValidData_ReSync_box -> StateRecevingData_ValidData_HalfBitDuration_diamond[style = "invis"];
	
		StateRecevingData_ValidData_HalfBitDuration_box -> StateRecevingData_IsSixOnes_diamond; StateRecevingData_IsSixOnes_diamond[shape = "diamond", label = "ones < 6"];
		StateRecevingData_IsSixOnes_diamond:w -> StateRecevingData_LessThanSix_box[label = "< 6"]; StateRecevingData_LessThanSix_box[shape = "box", label = "packet(bit_count) := bit_received;\ncrc16_buf := bit_received ## crc16_buf(15 downto 1);\nbit_count++;"]
		StateRecevingData_LessThanSix_box -> StateRecevingData_IsCRC16_diamond; StateRecevingData_IsCRC16_diamond[shape = "diamond", label = "bit_count(2 downto 0) === \"111\""]; 
		StateRecevingData_IsCRC16_diamond -> StateRecevingData_CalcCRC16_box[label = "8th bit ?"]; StateRecevingData_CalcCRC16_box[shape = "box", label = "calculated_crc16 := calc_crc16_usb(calculated_crc16, crc16_buf"];


		StateRecevingData_IsSixOnes_diamond:e -> StateRecevingData_Six[label = "=6"]; StateRecevingData_Six[shape = "box", label = "ones := 0;"]
		//StateRecevingData_ValidData_One_box -> StateRecevingData_IsSixOnes_diamond[style = "invis"]
		//StateRecevingData_ValidData_ReSync_box -> StateRecevingData_ValidData_IsOne_diamond[style = "invis"]
		StateRecevingData_ValidData_ReSync_diamond -> StateRecevingData_ValidData_IsOne_diamond[style = "invis"]
			
	}
}

